<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.rtb.mapper.AdFreqMapper">

    <insert id="increment">
        INSERT INTO ad_freq (
        ad_id,
        cnt
        )
        VALUES (
        #{adId},
        1
        )
        ON DUPLICATE KEY UPDATE
        cnt = cnt + 1
    </insert>

</mapper>